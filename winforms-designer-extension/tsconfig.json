{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "src/shared/**/*.ts",
    "src/core/**/*.ts",
    "src/extension/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "out-test",
    "src/webview"
  ]
}
