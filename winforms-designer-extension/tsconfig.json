{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es6",
        "outDir": "out",
        "lib": [
            "es2018",
            "dom"
        ],
        "types": [
            "node"
        ],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noUncheckedIndexedAccess": true
    },
    "exclude": [
        "node_modules",
        ".vscode-test",
        "tests",
        "out-test"
    ]
}