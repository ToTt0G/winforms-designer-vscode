{
  "name": "winforms-designer-modern",
  "displayName": "Modern WinForms Designer (Cross-Platform)",
  "description": "Zero-setup visual Windows Forms (.Designer.cs) designer for VS Code — live DPI preview, layout auditor, snaplines & C# sync on Windows, macOS & Linux. No .NET needed.",
  "version": "1.1.0",
  "publisher": "ToTt0G",
  "author": {
    "name": "ToTt0G"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#181A20",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "winforms",
    "windows forms",
    "visual designer",
    "form designer",
    "gui designer",
    "cross-platform",
    "macos",
    "linux",
    "live preview",
    "layout auditor",
    "wysiwyg",
    "drag and drop",
    "csharp",
    "c#",
    "dotnet",
    ".net",
    "designer.cs",
    "visual studio"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ToTt0G/winforms-designer-vscode.git",
    "directory": "winforms-designer-extension"
  },
  "bugs": {
    "url": "https://github.com/ToTt0G/winforms-designer-vscode/issues"
  },
  "homepage": "https://github.com/ToTt0G/winforms-designer-vscode#readme",
  "qna": "marketplace",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:winformsDesigner.editor",
    "onView:winformsDesigner.formsView",
    "onCommand:winforms.openDesigner",
    "onCommand:winforms.newForm",
    "onCommand:winforms.newUserControl",
    "onCommand:winforms.newProject",
    "onCommand:winforms.viewCode",
    "onCommand:winforms.viewDesignerCode",
    "onCommand:winforms.buildApp",
    "onCommand:winforms.runApp",
    "onCommand:winforms.stopApp",
    "onCommand:winforms.deleteForm",
    "onCommand:winforms.refreshFormsView"
  ],
  "contributes": {
    "configurationDefaults": {
      "explorer.fileNesting.enabled": true,
      "explorer.fileNesting.patterns": {
        "*.cs": "${capture}.Designer.cs, ${capture}.designer.cs, ${capture}.resx"
      }
    },
    "customEditors": [
      {
        "viewType": "winformsDesigner.editor",
        "displayName": "WinForms Visual Designer",
        "selector": [
          {
            "filenamePattern": "*.Designer.cs"
          },
          {
            "filenamePattern": "*.designer.cs"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "winformsDesigner",
          "title": "WinForms Designer",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "winformsDesigner": [
        {
          "id": "winformsDesigner.formsView",
          "name": "Forms & Controls"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "winformsDesigner.formsView",
        "contents": "No WinForms (.Designer.cs) files found in this workspace.\n[New WinForms Project...](command:winforms.newProject)\n[New Windows Form...](command:winforms.newForm)"
      }
    ],
    "commands": [
      {
        "command": "winforms.openDesigner",
        "title": "Open WinForms Designer",
        "category": "WinForms",
        "icon": "$(layout)"
      },
      {
        "command": "winforms.viewCode",
        "title": "View Form Code",
        "category": "WinForms",
        "icon": "$(code)"
      },
      {
        "command": "winforms.viewDesignerCode",
        "title": "View Designer Code Side by Side",
        "category": "WinForms",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "winforms.newForm",
        "title": "New Windows Form...",
        "category": "WinForms",
        "icon": "$(new-file)"
      },
      {
        "command": "winforms.newUserControl",
        "title": "New User Control...",
        "category": "WinForms",
        "icon": "$(symbol-class)"
      },
      {
        "command": "winforms.newProject",
        "title": "New WinForms Project...",
        "category": "WinForms",
        "icon": "$(new-folder)"
      },
      {
        "command": "winforms.buildApp",
        "title": "Build WinForms Project",
        "category": "WinForms",
        "icon": "$(tools)"
      },
      {
        "command": "winforms.runApp",
        "title": "Run WinForms Project",
        "category": "WinForms",
        "icon": "$(play)"
      },
      {
        "command": "winforms.stopApp",
        "title": "Stop Running WinForms App",
        "category": "WinForms",
        "icon": "$(debug-stop)"
      },
      {
        "command": "winforms.deleteForm",
        "title": "Delete Form & Sibling Files",
        "category": "WinForms",
        "icon": "$(trash)"
      },
      {
        "command": "winforms.refreshFormsView",
        "title": "Refresh Forms Explorer",
        "category": "WinForms",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "winforms.openDesigner",
          "when": "resourceExtname == .cs && activeCustomEditorId != winformsDesigner.editor",
          "group": "navigation"
        },
        {
          "command": "winforms.viewCode",
          "when": "activeCustomEditorId == winformsDesigner.editor",
          "group": "navigation@1"
        },
        {
          "command": "winforms.viewDesignerCode",
          "when": "activeCustomEditorId == winformsDesigner.editor",
          "group": "navigation@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "winforms.openDesigner",
          "when": "resourceExtname == .cs",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "winforms.openDesigner",
          "when": "resourceExtname == .cs",
          "group": "navigation@1"
        },
        {
          "command": "winforms.newForm",
          "when": "explorerResourceIsFolder",
          "group": "navigation@2"
        },
        {
          "command": "winforms.newUserControl",
          "when": "explorerResourceIsFolder",
          "group": "navigation@3"
        },
        {
          "command": "winforms.newProject",
          "when": "explorerResourceIsFolder",
          "group": "navigation@4"
        },
        {
          "command": "winforms.deleteForm",
          "when": "resourceExtname == .cs",
          "group": "7_modification@1"
        }
      ],
      "view/title": [
        {
          "command": "winforms.newForm",
          "when": "view == winformsDesigner.formsView",
          "group": "navigation@1"
        },
        {
          "command": "winforms.runApp",
          "when": "view == winformsDesigner.formsView",
          "group": "navigation@2"
        },
        {
          "command": "winforms.buildApp",
          "when": "view == winformsDesigner.formsView",
          "group": "navigation@3"
        },
        {
          "command": "winforms.refreshFormsView",
          "when": "view == winformsDesigner.formsView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "winforms.openDesigner",
          "when": "view == winformsDesigner.formsView && viewItem == winformsForm",
          "group": "inline@1"
        },
        {
          "command": "winforms.viewCode",
          "when": "view == winformsDesigner.formsView && viewItem == winformsForm",
          "group": "inline@2"
        },
        {
          "command": "winforms.deleteForm",
          "when": "view == winformsDesigner.formsView && viewItem == winformsForm",
          "group": "7_modification@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "winforms.openDesigner",
        "key": "shift+f7",
        "when": "editorTextFocus && resourceExtname == .cs"
      },
      {
        "command": "winforms.viewCode",
        "key": "f7",
        "when": "activeCustomEditorId == winformsDesigner.editor"
      }
    ],
    "configuration": {
      "title": "Modern WinForms Designer",
      "properties": {
        "winformsDesigner.gridSize": {
          "type": "number",
          "default": 8,
          "enum": [4, 8, 12, 16],
          "description": "Snap grid spacing in pixels when moving or resizing controls."
        },
        "winformsDesigner.layoutMode": {
          "type": "string",
          "default": "snaplines",
          "enum": ["snaplines", "grid"],
          "enumDescriptions": [
            "Show Visual Studio-style alignment and spacing snaplines.",
            "Snap control positions and sizes strictly to the grid."
          ],
          "description": "Default layout alignment mode on the design canvas."
        },
        "winformsDesigner.showGrid": {
          "type": "boolean",
          "default": true,
          "description": "Display the alignment dot grid on the form design surface."
        },
        "winformsDesigner.renderStyle": {
          "type": "string",
          "default": "fluent",
          "enum": ["fluent", "classic"],
          "enumDescriptions": [
            "Windows 11 Fluent-inspired control rendering.",
            "Classic Windows Forms control rendering."
          ],
          "description": "Visual rendering style used for controls on the design surface."
        },
        "winformsDesigner.codeStyle.useThisQualifier": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "always", "never"],
          "description": "Whether generated InitializeComponent() statements prefix control references with 'this.' ('auto' matches the existing file)."
        },
        "winformsDesigner.codeStyle.eventHandlerStyle": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "shorthand", "explicitDelegate"],
          "description": "How event subscriptions are emitted in .Designer.cs ('auto' matches the existing file)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "build:dev": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test:unit": "node esbuild.mjs --tests && node --test \"out-test/**/*.test.js\"",
    "test:e2e": "node test/e2e/designer.e2e.mjs",
    "test": "npm run typecheck && npm run build && npm run test:unit",
    "package": "npx @vscode/vsce package --no-dependencies --baseContentUrl https://github.com/ToTt0G/winforms-designer-vscode/blob/main/winforms-designer-extension --baseImagesUrl https://raw.githubusercontent.com/ToTt0G/winforms-designer-vscode/main/winforms-designer-extension"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
