# .gitignore for Visual Editor Extension

# Build results
[Bb]in/
[Oo]bj/
dist/
out/
out-test/
build/
[Aa]rtifacts/
TestResults/

# Visual Studio / VS Code
.vscode/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Node.js
node_modules/
npm-debug.log
yarn-error.log

# C# / .NET
*.pdb
*.dll
*.exe
*.cache
*.deps.json
*.runtimeconfig.json

# Extension and package artifacts
*.vsix
*.nupkg
*.snupkg

# Compiled test output — tests are authored in TypeScript and run from out-test/
**/tests/**/*.js
**/tests/**/*.js.map

# OS generated files
.DS_Store
Thumbs.db
